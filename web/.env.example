# Copy to .env.local (never commit it). Everything below works on free tiers.

# --- Public (shipped to the browser) ---------------------------------------------
NEXT_PUBLIC_CLUSTER=devnet
# A public endpoint, or a Helius URL restricted to your domain. Never put a secret key here.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional buttons (hidden until set; redeploy after changing):
# X/Twitter handle ("abysshaul", "@abysshaul") or https://x.com/abysshaul
NEXT_PUBLIC_TWITTER=
# Token contract (mint) address on pump.fun
NEXT_PUBLIC_PUMPFUN_CA=

# --- Server only -------------------------------------------------------------------
# Helius free plan: keyed RPC, priority-fee estimates and the webhook. Optional; without it the
# app uses the public RPC and the RPC fallback for priority fees.
HELIUS_API_KEY=
# Set the same value as the webhook's "Authorization" header in the Helius dashboard.
HELIUS_WEBHOOK_SECRET=
# Neon free plan. Optional; without it the ledger reads recent transactions from the RPC.
# Create the table with: npx drizzle-kit push
DATABASE_URL=

# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/keeper.
CRON_SECRET=
# Keeper hot wallet: a JSON array secret key with a few cents of SOL and NO admin rights.
KEEPER_SECRET_KEY=
